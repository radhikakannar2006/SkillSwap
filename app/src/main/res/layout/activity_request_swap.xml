<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.activity.RequestSwapActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top Navigation Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_back_request_swap"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="21dp"
            app:cardElevation="1.5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/dark_text" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="Request Swap"
            android:textColor="@color/dark_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/card_back_request_swap"
            app:layout_constraintStart_toEndOf="@id/card_back_request_swap"
            app:layout_constraintTop_toTopOf="@id/card_back_request_swap" />

        <!-- User Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_user_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_back_request_swap"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_swap_target_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <TextView
                    android:id="@+id/tv_swap_target_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Ananya S."
                    android:textColor="@color/dark_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/iv_swap_target_avatar"
                    app:layout_constraintTop_toTopOf="@id/iv_swap_target_avatar" />

                <ImageView
                    android:id="@+id/iv_star_target"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_star"
                    app:layout_constraintBottom_toBottomOf="@id/tv_swap_target_name"
                    app:layout_constraintStart_toEndOf="@id/tv_swap_target_name"
                    app:layout_constraintTop_toTopOf="@id/tv_swap_target_name" />

                <TextView
                    android:id="@+id/tv_swap_target_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif"
                    android:text="4.8 (24)"
                    android:textColor="@color/dark_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tv_swap_target_name"
                    app:layout_constraintStart_toEndOf="@id/iv_star_target"
                    app:layout_constraintTop_toTopOf="@id/tv_swap_target_name" />

                <TextView
                    android:id="@+id/tv_target_teaches"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Teaches: Web Design, Figma"
                    android:textColor="@color/muted_text"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_swap_target_avatar"
                    app:layout_constraintTop_toBottomOf="@id/tv_swap_target_name" />

                <TextView
                    android:id="@+id/tv_target_wants"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Wants: Python, Data Analysis"
                    android:textColor="@color/muted_text"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_swap_target_avatar"
                    app:layout_constraintTop_toBottomOf="@id/tv_target_teaches" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Swap Form Section -->
        <TextView
            android:id="@+id/tv_form_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="What would you like to do?"
            android:textColor="@color/dark_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_user_summary" />

        <!-- I Want To Learn Spinner Container -->
        <TextView
            android:id="@+id/tv_label_learn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:text="I want to learn"
            android:textColor="@color/muted_text"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_form_section_title" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_spinner_learn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_learn"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinner_want_to_learn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- I Can Teach Spinner Container -->
        <TextView
            android:id="@+id/tv_label_teach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:text="I can teach"
            android:textColor="@color/muted_text"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_spinner_learn" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_spinner_teach"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_teach"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinner_can_teach"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Custom Message -->
        <TextView
            android:id="@+id/tv_label_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:text="Add a message (optional)"
            android:textColor="@color/muted_text"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_spinner_teach" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_message"
            style="@style/Widget.SkillSwap.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:counterEnabled="true"
            app:counterMaxLength="200"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_message">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_message"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:hint="Hi! I'm interested in swapping skills..."
                android:inputType="textMultiLine"
                android:maxLength="200"
                android:textColor="@color/dark_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Send Request Primary Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_request"
            style="@style/Widget.SkillSwap.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="Send Request"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_message" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
