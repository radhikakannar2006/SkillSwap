<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_rounded_card"
        android:backgroundTint="@color/card_stroke" />

    <!-- Title & Subtitle -->
    <TextView
        android:id="@+id/tv_swap_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/dark_text"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Request Skill Swap" />

    <TextView
        android:id="@+id/tv_swap_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:text="Choose what skill you will offer and what skill you want in return."
        android:textColor="@color/muted_text"
        android:textSize="13sp" />

    <!-- 1. What I Offer Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="1. Skill You Will Offer"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_my_offered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="8dp"
        app:singleSelection="true" />

    <TextView
        android:id="@+id/tv_no_offered_skills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="You haven't added any skills to teach yet. Go to Edit Profile to add some!"
        android:textColor="@color/error_warning"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 2. What I Want Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-medium"
        android:text="2. Skill You Want to Learn"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_target_skills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="8dp"
        app:singleSelection="true" />

    <TextView
        android:id="@+id/tv_no_target_skills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="This user has not listed any teaching skills yet."
        android:textColor="@color/muted_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 3. Skill Difficulty & Coin Pricing -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-medium"
        android:text="3. Skill Level (Learning Cost)"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_skill_level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="8dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_level_beginner"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Beginner (1 Coin)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_level_intermediate"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intermediate (2 Coins)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_level_advanced"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Advanced (3 Coins)" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Wallet Balance Status Box -->
    <LinearLayout
        android:id="@+id/layout_wallet_balance_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_rounded_card"
        android:backgroundTint="@color/light_green_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_coin" />

        <TextView
            android:id="@+id/tv_wallet_balance_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/dark_text"
            android:textSize="13sp"
            tools:text="Your Balance: 5 Skill Coins (Required: 1 Coin)" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_insufficient_coins_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="You don't have enough Skill Coins. Teach a skill to earn more coins."
        android:textColor="@color/error_warning"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <!-- Submit Swap Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_send_swap_request"
        style="@style/Widget.SkillSwap.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Send Swap Request"
        android:textColor="@color/white"
        android:textSize="15.5sp"
        app:cornerRadius="16dp" />

</LinearLayout>
