<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_card_session_skill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-bold"
                android:text="Python Session"
                android:textColor="#0F172A"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_card_session_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="#EFF6FF"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="SCHEDULED"
                android:textColor="#2563EB"
                android:textSize="11sp" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_card_session_partner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Teacher: Ananya"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_card_session_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="28 Sep 2026 at 6:00 PM (1 Hour · 2 Coins)"
            android:textColor="#2E7D5B"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_card_join_meet"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Join Meet"
                android:textColor="#2E7D5B"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_coin"
                app:iconTint="#2E7D5B"
                app:strokeColor="#2E7D5B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_card_view_details"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#2E7D5B"
                android:text="Session Room"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
