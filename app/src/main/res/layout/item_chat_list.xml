<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatListItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4.5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1.5dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Friend Avatar Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatarCard"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/primary_green_subtle"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/primary_green_subtle"
            app:strokeWidth="1.5dp">

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/primary_green"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="A" />

            <ImageView
                android:id="@+id/ivFriendAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Unread dot on the right side of the avatar -->
        <View
            android:id="@+id/viewProfileUnreadDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_notification_badge"
            android:elevation="2dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/avatarCard"
            app:layout_constraintEnd_toEndOf="@id/avatarCard" />

        <!-- Friend Name -->
        <TextView
            android:id="@+id/tvFriendName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/dark_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvMessageTime"
            app:layout_constraintStart_toEndOf="@id/avatarCard"
            app:layout_constraintTop_toTopOf="@id/avatarCard"
            tools:text="Alex Rivera" />

        <!-- Last Message Timestamp -->
        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/muted_text"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvFriendName"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="10:45 AM" />

        <!-- Last Message Preview -->
        <TextView
            android:id="@+id/tvLastMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/muted_text"
            android:textSize="13.5sp"
            app:layout_constraintBottom_toBottomOf="@id/avatarCard"
            app:layout_constraintEnd_toStartOf="@id/layoutRightStatus"
            app:layout_constraintStart_toEndOf="@id/avatarCard"
            app:layout_constraintTop_toBottomOf="@id/tvFriendName"
            tools:text="Hey! Let's start the UI/UX design session." />

        <!-- Right status container (Unread Icon + Matched Badge) -->
        <LinearLayout
            android:id="@+id/layoutRightStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/tvLastMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvLastMessage">

            <!-- Unread chat icon indicator -->
            <ImageView
                android:id="@+id/ivUnreadIndicatorRight"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="New unread message"
                android:src="@drawable/ic_chat"
                android:visibility="gone"
                app:tint="@color/primary_green"
                tools:visibility="visible" />

            <!-- Active Swap Tag Badge -->
            <TextView
                android:id="@+id/swapBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/status_active_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Matched"
                android:textColor="@color/status_active_text"
                android:textSize="11sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
