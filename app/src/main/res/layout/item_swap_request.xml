<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="1.5dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_swap_avatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/primary_green_subtle"
                app:strokeWidth="1.5dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view_unread_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_online_dot"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_swap_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/dark_text"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        tools:text="Alex Rivera" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_swap_skills_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/muted_text"
                    android:textSize="13sp"
                    tools:text="Offers: Python ➔ Wants: Design" />

                <TextView
                    android:id="@+id/tv_notification_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/muted_text"
                    android:textSize="11.5sp"
                    android:visibility="gone"
                    tools:text="2 min ago"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_swap_status_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/status_pending_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/status_pending_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="PENDING" />
        </LinearLayout>

        <!-- Action Buttons (Accept / Decline) for received requests -->
        <LinearLayout
            android:id="@+id/layout_received_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_decline_swap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Decline"
                android:textColor="@color/error_warning"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/error_warning" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accept_swap"
                style="@style/Widget.SkillSwap.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="Accept Swap"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- Action Button (Delete / Cancel) for sent requests -->
        <LinearLayout
            android:id="@+id/layout_sent_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_swap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Delete Request"
                android:textColor="@color/error_red"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconTint="@color/error_red"
                app:strokeColor="@color/error_red" />

        </LinearLayout>

        <!-- Action Button (Message) for accepted requests -->
        <LinearLayout
            android:id="@+id/layout_accepted_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_message_swap"
                style="@style/Widget.SkillSwap.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="18dp"
                android:text="Message"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
