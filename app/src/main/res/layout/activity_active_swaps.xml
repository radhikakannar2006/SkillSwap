<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:fitsSystemWindows="true"
    tools:context=".ui.activity.ActiveSwapsActivity">

    <!-- Top Header Bar -->
    <FrameLayout
        android:id="@+id/layout_header_active_swaps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="start|center_vertical"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="21dp"
            app:cardElevation="1.5dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/btn_back_active_swaps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/dark_text" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_active_swaps_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Active Swaps"
                android:textColor="@color/dark_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_active_swaps_count_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="0 partners"
                android:textColor="@color/muted_text"
                android:textSize="12.5sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Notification Permission Disabled Banner -->
    <include
        android:id="@+id/bannerNotificationPermission"
        layout="@layout/view_notification_permission_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header_active_swaps" />

    <!-- Search Bar Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_search_active_swaps"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="26dp"
        app:cardElevation="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bannerNotificationPermission"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/primary_green" />

            <EditText
                android:id="@+id/et_search_active_swaps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="Search partners by name or skill..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/dark_text"
                android:textColorHint="@color/muted_text"
                android:textSize="14.5sp" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear Search"
                android:padding="3dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/muted_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Active Swaps RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_active_swaps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_search_active_swaps"
        tools:listitem="@layout/item_active_swap" />

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar_active_swaps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/primary_green"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_search_active_swaps" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_active_swaps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_search_active_swaps">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:cardBackgroundColor="@color/primary_green_subtle"
            app:cardCornerRadius="44dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="No Active Swaps"
                android:src="@drawable/ic_swap_exchange"
                app:tint="@color/primary_green" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_empty_active_swaps_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="No Active Swaps"
            android:textColor="@color/dark_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_active_swaps_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="When a skill swap is accepted, your partners will be shown here. You can chat or end swaps anytime."
            android:textColor="@color/muted_text"
            android:textSize="13.5sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
