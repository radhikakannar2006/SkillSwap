<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="1.5dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Avatar, Partner Name, Skills, Active Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Clickable Avatar -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_active_swap_avatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Partner Profile Picture"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/primary_green_subtle"
                app:strokeWidth="1.5dp" />

            <!-- Partner Info (Clickable) -->
            <LinearLayout
                android:id="@+id/layout_partner_name_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_active_swap_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/dark_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Sophia Reynolds" />

                <TextView
                    android:id="@+id/tv_active_swap_skills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:textColor="@color/muted_text"
                    android:textSize="13sp"
                    tools:text="Trading: Python ➔ UI Design" />
            </LinearLayout>

            <!-- Status Pill -->
            <TextView
                android:id="@+id/tv_active_swap_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/status_active_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ACTIVE"
                android:textColor="@color/status_active_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/card_stroke" />

        <!-- Actions Row: Schedule Session, Message & End Swap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Schedule Session Button (Primary Green) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_schedule_session_card"
                style="@style/Widget.SkillSwap.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:fontFamily="sans-serif-medium"
                android:text="Schedule"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_calendar"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconTint="@color/white" />

            <!-- Message Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_message_partner"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Chat"
                android:textColor="@color/primary_green"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconTint="@color/primary_green"
                app:strokeColor="@color/primary_green"
                app:strokeWidth="1dp" />

            <!-- End Swap Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_end_active_swap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="End"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/error_red"
                app:strokeWidth="1dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
