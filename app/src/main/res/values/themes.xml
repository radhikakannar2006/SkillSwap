<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SkillSwapProject" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Palette Colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_green_accent</item>
        <item name="colorOnPrimaryContainer">@color/dark_text</item>

        <item name="colorSecondary">@color/light_green_accent</item>
        <item name="colorOnSecondary">@color/dark_text</item>

        <item name="colorError">@color/error_warning</item>
        <item name="colorOnError">@color/white</item>

        <!-- Global Window Background set to Cream (#F9F7F3) -->
        <item name="android:windowBackground">@color/cream_background</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorSurfaceVariant">@color/cream_background</item>
        <item name="colorOnSurfaceVariant">@color/muted_text</item>

        <!-- Typography -->
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.SkillSwap.Button</item>
        <item name="textInputStyle">@style/Widget.SkillSwap.TextInputLayout</item>
    </style>

    <style name="Theme.SkillSwapProject" parent="Base.Theme.SkillSwapProject" />

    <!-- Primary Button Style: Primary Green (#2E7D5B) with White Text -->
    <style name="Widget.SkillSwap.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Outlined Button Style -->
    <style name="Widget.SkillSwap.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_green</item>
        <item name="android:textColor">@color/primary_green</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Text Input Outline Layout -->
    <style name="Widget.SkillSwap.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_green</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/muted_text</item>
    </style>

    <!-- Elevated Card Style -->
    <style name="Widget.SkillSwap.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Heading Text Style -->
    <style name="TextAppearance.SkillSwap.Heading" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Subtitle Text Style -->
    <style name="TextAppearance.SkillSwap.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/muted_text</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>